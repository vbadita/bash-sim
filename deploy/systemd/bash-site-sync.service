[Unit]
Description=Pull the bash simulator static site (branch "site", built and tested by CI)
Documentation=https://github.com/vbadita/bash-sim
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/bash-site-sync
User=bash-web
Group=bash-web
# Writable: only its own directory. Everything else read-only.
ProtectSystem=strict
ReadWritePaths=/srv/bash-sim
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
